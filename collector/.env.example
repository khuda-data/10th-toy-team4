# 공공데이터포털에서 발급받은 경기도 버스 API 인증키입니다.
# 여러 개면 쉼표로 구분합니다. 일반 키(Decoding)와 URL 인코딩 키(Encoding)를 모두 지원합니다.
# 예: GBIS_SERVICE_KEYS=첫번째키,두번째키
GBIS_SERVICE_KEYS=

# 기존 단일 키 설정도 계속 지원합니다. 위 GBIS_SERVICE_KEYS와 동시에 설정하면 다중 키가 우선합니다.
# GBIS_SERVICE_KEY=단일키

# collector/config/routes.txt 대신 환경변수로 노선 ID를 지정할 수도 있습니다.
# GBIS_ROUTE_IDS=200000037,233000031

# 아래 값은 필요한 경우에만 변경하세요.
GBIS_DB_PATH=data/gbis.sqlite3
GBIS_REQUEST_TIMEOUT_SECONDS=20
# 인증키 하나당 위치 API 일일 안전 한도입니다.
GBIS_DAILY_REQUEST_LIMIT=1000
GBIS_STORE_RAW_RESPONSES=true

# 읽기 전용 API 설정입니다. 팀원별로 충분히 긴 키를 만들어 쉼표로 구분하세요.
# 예: python3 -c "import secrets; print('gbis_' + secrets.token_urlsafe(32))"
GBIS_API_KEYS=
GBIS_API_HOST=127.0.0.1
GBIS_API_PORT=8000
GBIS_API_MAX_PAGE_SIZE=500
GBIS_API_MAX_HISTORY_DAYS=30
